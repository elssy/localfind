{
  "expo": {
    "name": "Local Find",
    "slug": "local-find",
    "scheme": "localfind",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localfind.app",
      "config": {
        "googleMapsApiKey": "MOCK_KEY"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.localfind.app",
      "config": {
        "googleMaps": {
          "apiKey": "MOCK_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e76fe5fc-d9a8-49e9-bb2d-53e480e37c52"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e76fe5fc-d9a8-49e9-bb2d-53e480e37c52"
    }
  }
}
