{
  "expo": {
    "name": "Local Find",
    "slug": "local-find",
    "scheme": "localfind",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.localfind.app",
      "config": {
        "googleMapsApiKey": "MOCK_KEY"
      }
    },
    "android": {
      "package": "com.localfind.app",
      "config": {
        "googleMaps": {
          "apiKey": "MOCK_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"]
  }
}
